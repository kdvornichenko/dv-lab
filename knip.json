{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": [
				"scripts/**/*.mjs",
				"scripts/dev-checks/time-zone-quality.ts",
				"scripts/dev-checks/calendar-quality.ts",
				"e2e/**/*.ts"
			],
			"project": ["scripts/**/*.mjs", "scripts/**/*.ts", "e2e/**/*.ts"],
			"ignoreDependencies": ["pg"]
		},
		"apps/web": {
			"entry": ["public/sw.js"],
			"ignore": [
				"components/ui/**",
				"components/sidebar-app/**",
				"components/fluid-hover-highlight.tsx",
				"hooks/**",
				"lib/elevated.tsx",
				"lib/icon-context.tsx",
				"lib/shape-context.tsx",
				"lib/size-context.tsx",
				"lib/surface-context.tsx",
				"lib/font-weight.ts",
				"lib/popup.ts",
				"lib/sidebar-menu-grid.ts",
				"lib/springs.ts",
				"lib/surface-classes.ts",
				"lib/type-scale.ts",
				"lib/utils.ts"
			]
		},
		"apps/api": {
			"entry": ["src/server.ts", "src/migrate.ts", "src/bootstrap-teacher.ts", "src/import-vault.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/contracts": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/core": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/db": {
			"entry": ["src/index.ts", "drizzle.config.ts"],
			"project": ["src/**/*.ts"]
		}
	}
}
