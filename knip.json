{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": [
				"scripts/**/*.mjs",
				"scripts/dev-checks/time-zone-quality.ts",
				"scripts/dev-checks/calendar-quality.ts",
				"e2e/**/*.ts"
			],
			"project": ["scripts/**/*.mjs", "scripts/**/*.ts", "e2e/**/*.ts"],
			"ignoreDependencies": ["pg"]
		},
		"apps/web": {
			"entry": ["public/sw.js"],
			"ignore": [
				"components/ui/**",
				"lib/icon-context.tsx",
				"lib/shape-context.tsx",
				"lib/size-context.tsx",
				"lib/surface-classes.ts"
			]
		},
		"apps/api": {
			"project": ["src/**/*.ts"]
		},
		"packages/contracts": {
			"project": ["src/**/*.ts"]
		},
		"packages/core": {
			"project": ["src/**/*.ts"]
		},
		"packages/db": {
			"project": ["src/**/*.ts"]
		}
	}
}
