{
	"name": "dv-lab",
	"version": "0.1.0",
	"private": true,
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "portless dv-lab turbo run dev --filter=@dv-lab/api --filter=@dv-lab/web",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"format": "prettier --write . --config .prettierrc.json --cache --cache-location .cache/prettier",
		"format:check": "prettier --check . --config .prettierrc.json --cache --cache-location .cache/prettier",
		"knip": "knip --no-progress",
		"db:generate": "yarn workspace @dv-lab/db db:generate",
		"db:migrate": "yarn workspace @dv-lab/api db:migrate"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"knip": "6.40.0",
		"portless": "0.15.7",
		"prettier": "3.9.9",
		"prettier-plugin-tailwindcss": "0.8.1",
		"turbo": "2.11.7",
		"typescript": "6.0.3"
	}
}
